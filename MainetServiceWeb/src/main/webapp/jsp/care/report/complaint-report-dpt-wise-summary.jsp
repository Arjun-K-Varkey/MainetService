           			<div class="col-xs-12 col-sm-12 label-text">
						<table class="care-report-table-header care-exl-export margin-left-25" align="center">
							<tr>
								<th><spring:message code="care.reports.fromDate" text="From Date"/></th>
								<td> : &nbsp ${command.complaintReport.fromDate}</td>
								<th><spring:message code="care.reports.toDate" text="To Date"/></th>
								<td> : &nbsp ${command.complaintReport.toDate}</td>
								
								
								<c:if test="${command.complaintReport.empName ne null}">
		
								<th><spring:message code="care.employeename" text="Employee Name"/></th>
								<td> : &nbsp ${command.complaintReport.empName}</td>

								</c:if>
							</tr>
							<tr>
								<th><spring:message code="care.reports.generatedBy" text="Generated By"/></th>
								<td> : &nbsp ${userSession.employee.empname} ${userSession.employee.empmname} ${userSession.employee.emplname}</td>
								<th><spring:message code="care.reports.generatedDate" text="Generated Date"/></th>
								<td> : &nbsp ${command.complaintReport.dateTime}</td>
							</tr>
