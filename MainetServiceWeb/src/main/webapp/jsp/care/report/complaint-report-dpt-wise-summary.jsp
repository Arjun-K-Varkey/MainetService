            <div id="export-excel">
            <div class="table-responsive margin-top-10">
              <table class="table table-bordered margin-bottom-10 care-exl-export" id="report-table">
              		<div class="excel-title" id='tlExcel' style="display:none;">${command.complaintReport.title}</div> 
              		<thead>
	               		<tr>	               		
		                 <th  class="text-center width-6" style="vertical-align: middle;"><spring:message code="care.reports.SrNo" text="Sr. No."/></th>
		                 <th class="text-center"  width="8%"  data-sortinitialorder="asc"><spring:message code="care.reports.department" text="Complaint Type"/></th>
		                  <th class="text-center"  width="10%" data-sortinitialorder="asc"><spring:message code="care.reports.table.complaintType" text="Complaint Sub Type"/></th>
									<c:choose>
										<c:when
											test="${command.complaintReport.status eq 'PENDING' || command.complaintReport.status eq '-1'}">
											<th class="text-center width-8"><spring:message
													code="care.pending.complaint" text="Pending Complaint" /></th>
										</c:when>
									</c:choose>


									<c:choose>
										<c:when
											test="${command.complaintReport.status eq 'APPROVED' || command.complaintReport.status eq '-1'}">
											<th class="text-center width-8"><spring:message
													code="care.closed.complaint" text="Closed Complaint" /></th>
										</c:when>
									</c:choose>
									
									
									<c:choose>
		                  		<c:when test="${command.complaintReport.status eq '-1'}">
		                  			<th class="text-center  width-8"  data-sortinitialorder="asc"><spring:message code="care.total.noOf.complaint" text="Total Number of Complaints"/></th>
		                  		</c:when>
		                  </c:choose>
									
									
									
		                </tr>
	                </thead>
	            
				
					 <c:set var="totalCount" value="0"/>
					 <c:set var="totalClosedCount" value="0"></c:set>
					<c:set var="totalPendingCount" value="0"></c:set>
	                <tbody>
	               
     				<c:forEach items="${command.complaintReport.complaintList}" var="complaint" varStatus="status">
     					<tr>
     	
     					 	<td class="text-center">${status.index + 1}</td>	
     					 	<td><c:out value="${complaint.departmentName}"></c:out></td>     				
     					 	<td><c:out value="${complaint.comlaintSubType}"></c:out></td>
     					 	
     					 	<c:choose>
     					   		<c:when test="${command.complaintReport.status eq 'PENDING' || command.complaintReport.status eq '-1'}">
  					       			<td style="text-align: center;"><c:out value="${complaint.pendingComplaints}"></c:out>
  					       				<c:set var="totalPendingCount" value="${totalPendingCount + complaint.pendingComplaints}" scope="page"></c:set>
  					       			</td>
  					       		</c:when>
  					        </c:choose>
  					       
  					       
  					       <c:choose>
					       		<c:when test="${command.complaintReport.status eq 'APPROVED' || command.complaintReport.status eq '-1'}">
     					   			<td style="text-align: center;"><c:out value="${complaint.closedComplaints}"></c:out>
     					   				<c:set var="totalClosedCount" value="${totalClosedCount + complaint.closedComplaints}" scope="page"></c:set>
     					   			</td>
     					   		</c:when>
     					   </c:choose>
     					 	    			
     					    <%-- <td style="text-align: center;"><c:out value="${complaint.totalnoOfComplaints}"></c:out></td>   
     					    
     					     --%>
     	
     					    
     					    <c:choose>
		                  		<c:when test="${command.complaintReport.status eq '-1'}">
  					       			<td style="text-align: center;"><c:out value="${complaint.totalnoOfComplaints}"></c:out></td>
  					    				<c:set var="totalCount" value="${totalCount + complaint.totalnoOfComplaints}" scope="page"></c:set></td>
  					    		</c:when>
  					      </c:choose>
     					    
     					     
     					     					 <%-- 
      				       <c:set var="totalCount" value="${totalCount + complaint.totalnoOfComplaints}" scope="page" /> --%>
       				       </tr>
      				</c:forEach>
     				</tbody>
     				<tfoot>
	                   		<tr class="text-bold totalCount">
									<th ></th>
									<th ></th>
									<th class="text-center"><spring:message code="care.reports.total.count" text="Total"/></th>
									
									<c:choose>
									<c:when test="${command.complaintReport.status eq 'PENDING' || command.complaintReport.status eq '-1'}">
										<th><c:out value="${totalPendingCount}"/></th>
									</c:when>
									
									</c:choose>
									
									<c:choose>
									<c:when test="${command.complaintReport.status eq 'APPROVED' || command.complaintReport.status eq '-1'}">
										<th><c:out value="${totalClosedCount}"/></th>
									</c:when>
									</c:choose>
									
									
									<c:choose>
		                  					<c:when test="${command.complaintReport.status eq '-1'}">
												<th class="text-center"><c:out value="${totalCount}"/></th>		
											</c:when>
									</c:choose>
									
																
							</tr>  
						</tfoot>
     			     
               </table>
             </div>
