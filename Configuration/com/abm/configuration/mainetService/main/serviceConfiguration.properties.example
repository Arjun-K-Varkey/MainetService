#################LDAP#################

#set this property 'Y' if LDAP is to be used
ldap.enabled=N

# LDAP context factory class name
ldap.context.factory=com.sun.jndi.ldap.LdapCtxFactory

# LDAP URL, example: ldap://localhost:389/
#ldap.url=ldap://192.168.100.241:389/CN=Users,DC=swastik,DC=abmindia,DC=com
#ldap.url=ldap://192.168.100.241:389/
ldap.url=ldap://localhost:389/

# Root Context of LDAP directory, Base DN to be used
ldap.rootcontext=

# Use context prefix for user authentication, true or false. Y means required
ldap.userContextPrefix.use=false

# User context to use, if useContextPrefix is set to true else not used

#ldap.userContextPrefix=swastik

# DN under which users are present
#For open LDAP
ldap.userContextParentDN=ou=Users,dc=nrda,dc=in
#For Active directory
#ldap.userContextParentDN=CN=Users,DC=swastik,DC=abmindia,DC=com

# User authentication search key, indicate the key to be used to verify user or
# login name, it could be cn or uid or userPrincipalName or any other key

ldap.userAccountKey=cn
#ldap.userAccountKey=userPrincipalName

# principal to use while connecting to the LDAP. Comment if anonymous login is allowed

ldap.securityPrincipal=cn=Manager,dc=nrda,dc=in
ldap.securityCredential=admin@abm2017

# Security authentication mechanism
ldap.security.auth.type=simple

#set this property 'Y' to show BPM work flow applications in department dash board 
bpm.enabled=Y

############ DMS Configuration
#set this property 'Y' if DMS is to be used
dms.configure=N

############ GRP Environment Common properties #################.

#Authentication code for GRP Environment.
grp.authentication.code=bWJhQHVsYi5jb206MTIz

#set this flag 'Y' to post data on GRP Environment. set this flag as 'N' in case of SUDA live.
grp.posting.enable=N

#department wise Account Head,Field and Function enable in GRP Environment (account integration part).
grp.function.store=N
grp.function.hrms=N

#if Y means allow multiple login 
allowMultiLogin=N


#password.expired.config.common = Y then all organization have same expired date which is define against "password.expired.config.days" property.
#password.expired.config.common = N than password calculated using "PVD" Prefix.
#Where Other Field vale is no of days required to Expired password
password.expired.config.common=Y
password.expired.config.days=45
bill.thread.pool.size=30

bill.queue.delay.ms=900000